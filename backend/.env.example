# SalesOrbit Application Environment
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_db

# Security & Secrets
SECRET_KEY=dev_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Optional LLM API Provider Key (Gemini / OpenAI / Groq)
# If provided, SalesOrbit AI will synthesize natural language responses using Gemini/OpenAI REST API.
# If omitted, SalesOrbit AI automatically uses its built-in zero-hallucination PostgreSQL Analytical Synthesizer.
LLM_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tejashalvankar2006@gmail.com
SMTP_PASSWORD=<YOUR_GMAIL_APP_PASSWORD>
SMTP_FROM_EMAIL=tejashalvankar2006@gmail.com
